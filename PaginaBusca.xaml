<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppMinhasCompras.Views.PaginaBusca"
             Title="Pesquisa de Produtos">

    <VerticalStackLayout Spacing="10" Padding="15">

        <!-- SearchBar com o evento TextChanged solicitado na agenda -->
        <SearchBar x:Name="txt_search"
                   Placeholder="Pesquisar produto pelo nome..."
                   TextChanged="txt_search_TextChanged" />

        <!-- ListView conforme abordado no material teórico -->
        <ListView x:Name="lst_produtos"
                  HasUnevenRows="True"
                  HeightRequest="500">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <ViewCell>
                        <VerticalStackLayout Padding="10" Spacing="5">
                            <Label Text="{Binding Descricao}" FontSize="18" FontAttributes="Bold" />
                            <Label Text="{Binding Preco, StringFormat='Preço: R$ {0:F2}'}" FontSize="14" TextColor="Gray" />
                        </VerticalStackLayout>
                    </ViewCell>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

    </VerticalStackLayout>
</ContentPage>